<Window x:Name="AutoSetWindow" x:Class="AutoSet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoSet"
        mc:Ignorable="d"
        Title="AutoSet" Height="195" Width="534" Icon="/folder.png" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowState="Normal" Background="White">
    <Grid HorizontalAlignment="Center" Width="520">
        <Button Content="Create Set" Margin="0,113,0,0" FontFamily="Arial" FontSize="20" Click="Button_Click_1" HorizontalAlignment="Center" Width="220" Cursor="Hand" Background="#FFAFAFAF" BorderThickness="2,2,2,2" BorderBrush="#FF505050" Height="52" VerticalAlignment="Top"/>
        <CheckBox x:Name="CheckPDF" Content="PDF" HorizontalAlignment="Left" Margin="37,49,0,0" FontFamily="Arial" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsChecked="True" Height="20" VerticalAlignment="Top"/>
        <CheckBox x:Name="CheckDWG" Content="DWG" HorizontalAlignment="Left" Margin="137,49,0,0" VerticalContentAlignment="Center" FontFamily="Arial" IsChecked="False" Height="20" VerticalAlignment="Top" HorizontalContentAlignment="Center"/>
        <CheckBox x:Name="CheckReport" Content="Reports" HorizontalAlignment="Left" Margin="237,49,0,0" FontFamily="Arial" VerticalContentAlignment="Center" Height="20" VerticalAlignment="Top" HorizontalContentAlignment="Center"/>
        <CheckBox x:Name="CheckNC" Content="NC" HorizontalAlignment="Left" Margin="337,49,0,0" FontFamily="Arial" VerticalContentAlignment="Center" RenderTransformOrigin="0.063,0.422" Height="20" VerticalAlignment="Top" HorizontalContentAlignment="Center"/>
        <CheckBox x:Name="CheckDXF" Content="DXF" Margin="428,49,0,0" VerticalAlignment="Top" Height="20" FontFamily="Arial" IsChecked="False" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
    </Grid>
</Window>
